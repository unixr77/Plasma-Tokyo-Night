{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file",
    "source": "~/.config/fastfetch/logo.txt",
    "padding": {
      "top": 1,
      "bottom": 1,
      "left": 2,
      "right": 4
    }
  },
  "display": {
    "separator": "   ",
    "color": {
      "keys": "cyan",
      "title": "blue"
    },
    "size": {
      "binaryPrefix": "si",
      "ndigits": 1
    }
  },
  "modules": [
    "title",
    {
      "type": "separator",
      "string": "─"
    },

    // Sistem & Ortam
    { "type": "os", "key": "OS" },
    { "type": "kernel", "key": "Kernel" },
    { "type": "uptime", "key": "Uptime" },
    { "type": "shell", "key": "Shell" },
    { "type": "de", "key": "DE" },
    { "type": "wm", "key": "WM" },
    { "type": "terminal", "key": "Terminal" },

    {
      "type": "separator",
      "string": "─"
    },

    // Donanım
    { "type": "cpu", "key": "CPU" },
    { "type": "gpu", "key": "GPU" },
    { "type": "memory", "key": "Memory" },
    {
      "type": "disk",
      "key": "Disk (/)",
      "folders": "/"
    },
    { "type": "battery", "key": "Battery" },

    {
      "type": "separator",
      "string": "─"
    },

    // Ağ & Görünüm
    { "type": "localip", "key": "Local IP" },
    {
      "type": "colors",
      "symbol": "circle"
    }
  ]
}