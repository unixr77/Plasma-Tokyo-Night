{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file",
    "source": "~/.config/fastfetch/logo3.txt",
    "padding": {
      "top": 1,
      "bottom": 1,
      "left": 2,
      "right": 4
    }
  },
  "display": {
    "separator": "   ",
    "key": {
      "width": 12
    },
    "color": {
      "keys": "cyan",
      "title": "blue"
    },
    "size": {
      "binaryPrefix": "iec",
      "ndigits": 1
    },
    "percent": {
      "type": 2
    }
  },
  "modules": [
    "title",
    {
      "type": "separator",
      "string": "─"
    },

    // Sistem & Ortam
    { "type": "os", "key": "OS" },
    { "type": "kernel", "key": "Kernel" },
    { "type": "uptime", "key": "Uptime" },
    { "type": "packages", "key": "Packages" },
    { "type": "shell", "key": "Shell" },
    { "type": "de", "key": "DE" },
    { "type": "wm", "key": "WM" },
    { "type": "terminal", "key": "Terminal" },

    {
      "type": "separator",
      "string": "─"
    },

    // Donanım
    { "type": "cpu", "key": "CPU" },
    { "type": "gpu", "key": "GPU" },
    {
      "type": "memory",
      "key": "Memory",
      "format": "{percentage-bar}  {used} / {total}"
    },
    {
      "type": "disk",
      "key": "Disk",
      "showRegular": true,
      "showExternal": true,
      "showSubvolumes": false,
      "format": "{size-percentage-bar}  {size-used} / {size-total}"
    },

    {
      "type": "separator",
      "string": "─"
    },

    // Ağ & Görünüm
    { "type": "localip", "key": "Local IP" },
    {
      "type": "colors",
      "symbol": "circle"
    }
  ]
}